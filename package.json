{
  "name": "focally",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/berkinory/focally"
  },
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "prebuild": "expo prebuild --no-install",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "android": "bun run prebuild:android && expo run:android",
    "android:device": "bun run prebuild:android && expo run:android --device",
    "ios": "bun run prebuild:ios && expo run:ios",
    "ios:device": "bun run prebuild:ios && expo run:ios --device",
    "android:apk": "bun scripts/build-apk.ts",
    "android:key": "bun scripts/create-signing-key.ts",
    "check": "ultracite fix --type-aware --type-check",
    "check:ci": "ultracite check --type-aware --type-check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.plugins.json",
    "test": "bun test scripts src/lib",
    "test:config": "bun test scripts/android-config.test.js",
    "test:jpeg": "bun scripts/test-jpeg.ts"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@hugeicons/core-free-icons": "4.3.3",
    "@hugeicons/react-native": "1.0.16",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "~19.2.2",
    "oxfmt": "^0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "^0.20.0",
    "typescript": "~6.0.3",
    "ultracite": "^7.9.3"
  },
  "overrides": {
    "oxlint": "1.73.0"
  },
  "packageManager": "bun@1.3.14",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
